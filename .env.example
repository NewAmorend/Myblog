# 登录后台使用的密码。请使用至少 16 位的随机密码。
BLOG_ADMIN_PASSWORD=replace-with-a-strong-password

# 用于签名登录会话，与后台密码不同。可用 `openssl rand -hex 32` 生成。
BLOG_ADMIN_SECRET=replace-with-at-least-32-random-characters

# GitHub fine-grained token，需要本仓库 Contents: Read and write 权限。
BLOG_GITHUB_TOKEN=github_pat_replace_me

# 在 Vercel 关联了本仓库时，owner/repo 会自动识别；以下配置可显式覆盖。
BLOG_GITHUB_OWNER=NewAmorend
BLOG_GITHUB_REPO=Myblog
BLOG_GITHUB_BRANCH=main
BLOG_SITE_URL=https://amorend.top

# 私有 Redis（Upstash REST API）；使用独立数据库，不在前端公开这些值。
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-private-redis-token

# 每个环境独立命名空间；生产和预览不能复用，以免共享会话、限速或草稿。
BLOG_STORAGE_NAMESPACE=amorend-production
